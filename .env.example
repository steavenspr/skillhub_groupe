# ══════════════════════════════════════
#  ENVIRONNEMENT RACINE — SkillHub
# ══════════════════════════════════════
# Copier ce fichier en .env et adapter les valeurs

# Backend Laravel
BACKEND_PORT=8000
FRONTEND_PORT=5173

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=skillhub
DB_USERNAME=skillhub_user
DB_PASSWORD=changeme123

# MongoDB
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=skillhub_logs
MONGODB_USERNAME=
MONGODB_PASSWORD=

# JWT Secret (généré via `php artisan jwt:secret` dans le container backend)
JWT_SECRET=

# Node/Frontend
VITE_API_BASE_URL=http://localhost:8000
NODE_ENV=development

# Docker compose
COMPOSE_PROJECT_NAME=skillhub-bloc03

